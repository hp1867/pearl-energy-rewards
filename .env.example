# Live mode is the default. Local demo is opt-in and must not be used in production.
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional integrations; these require separate provider setup.
VITE_GOOGLE_MAPS_API_KEY=
VITE_WEB_PUSH_PUBLIC_KEY=
VITE_WALLET_API_URL=

# NEVER add a service-role key, database password, POS secret, or private
# signing key to a VITE_ variable. See docs/database/SUPABASE.md.
