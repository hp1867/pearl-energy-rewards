# Server-only Edge secrets. Copy to ignored supabase/.env and fill privately.
# Do not put any of these secrets into VITE_ variables or Git.
# Keep this empty until the real POS integration is approved and tested.
POS_SIGNING_KEYS={}
# Shape: {"store-key-v1":{"integrationId":"DATABASE-INTEGRATION-UUID","provider":"vendor-code","secret":"RANDOM-SECRET-AT-LEAST-32-CHARACTERS"}}

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:REPLACE_WITH_SUPPORT_EMAIL
PUSH_WORKER_SECRET=

# Hosted Edge runtime supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# They must never be copied into browser environment variables.
