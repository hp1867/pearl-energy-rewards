{
  "name": "pearl-energy-rewards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pearl Energy Rewards - premium fuel station loyalty & rewards mobile app prototype",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "npm run test:night-deals && npm run test:supabase && npm run test:pos && npm run test:auth",
    "test:supabase": "node --test tests/supabase.test.mjs",
    "test:pos": "node --test tests/pos-contract.test.mjs tests/pos-intake.test.mjs",
    "test:auth": "node --test tests/auth-settings.test.mjs tests/member-identity.test.mjs",
    "test:reliability": "node --test tests/pos-reliability.test.mjs",
    "test:edge": "deno check --no-config --node-modules-dir=none --lock=supabase/functions/deno.lock supabase/functions/pos-api/index.ts supabase/functions/push-dispatch/index.ts supabase/functions/member-support/index.ts",
    "supabase:migrate": "supabase db push",
    "supabase:types": "supabase gen types typescript --linked",
    "test:night-deals": "node --test tests/nightDeals.test.mjs",
    "test:functions": "npm --prefix functions test",
    "test:integration": "npx firebase-tools emulators:exec --only firestore \"npm --prefix functions run test:integration\"",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "firebase:emulators": "npx firebase-tools emulators:start",
    "firebase:seed": "node scripts/seed.mjs",
    "firebase:deploy:firestore": "npx firebase-tools deploy --only firestore",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "firebase": "^12.18.0",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.417.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "2.9.6",
    "embedded-postgres": "18.4.0-beta.17",
    "firebase-admin": "^14.3.0",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "vite": "^8.2.2"
  }
}
