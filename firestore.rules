rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isStaff() {
      return signedIn()
        && (('staff' in request.auth.token && request.auth.token.staff == true) || isAdmin());
    }

    function canManageNightDeals(stationId) {
      return isAdmin()
        || (signedIn()
          && 'branchManager' in request.auth.token
          && request.auth.token.branchManager == true
          && 'permissions' in request.auth.token
          && request.auth.token.permissions is list
          && request.auth.token.permissions.hasAny(['nightDeals.manage'])
          && 'stationIds' in request.auth.token
          && request.auth.token.stationIds is list
          && request.auth.token.stationIds.hasAny([stationId]));
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validCustomerProfile(data) {
      return data.firstName is string
        && data.firstName.size() > 0
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() > 0
        && data.lastName.size() <= 80
        && data.name is string
        && data.name.size() <= 170
        && validOptionalString(data, 'mobile', 32)
        && validOptionalString(data, 'dob', 10);
    }

    function validNightDeal(data) {
      return data.keys().hasOnly([
          'id', 'stationId', 'productName', 'description', 'img',
          'originalPriceCents', 'dealPriceCents', 'quantityAvailable', 'status',
          'startsAt', 'sellUntil', 'safetyCutoffAt', 'businessDate', 'timezone',
          'schemaVersion', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'id', 'stationId', 'productName', 'originalPriceCents', 'dealPriceCents',
          'quantityAvailable', 'status', 'startsAt', 'sellUntil', 'safetyCutoffAt',
          'businessDate', 'timezone', 'schemaVersion', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy'
        ])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.stationId is string
        && data.stationId.size() > 0
        && data.stationId.size() <= 128
        && data.productName is string
        && data.productName.size() > 0
        && data.productName.size() <= 120
        && validOptionalString(data, 'description', 500)
        && validOptionalString(data, 'img', 32)
        && data.originalPriceCents is int
        && data.originalPriceCents > 0
        && data.originalPriceCents <= 1000000
        && data.dealPriceCents is int
        && data.dealPriceCents > 0
        && data.dealPriceCents < data.originalPriceCents
        && data.quantityAvailable is int
        && data.quantityAvailable >= 0
        && data.quantityAvailable <= 10000
        && data.status in ['active', 'paused', 'sold_out', 'expired']
        && data.startsAt is timestamp
        && data.sellUntil is timestamp
        && data.safetyCutoffAt is timestamp
        && data.startsAt < data.sellUntil
        && data.sellUntil <= data.startsAt + duration.value(25, 'h')
        && data.sellUntil <= data.safetyCutoffAt
        && (data.status != 'active' || (data.quantityAvailable > 0 && data.sellUntil > request.time))
        && data.businessDate is string
        && data.businessDate.size() == 10
        && data.timezone == 'Australia/Sydney'
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy is string;
    }

    // Customer is a read projection. Identity, balances, tiers, missions and
    // loyalty state are written only by trusted Cloud Functions/Admin SDK.
    match /customers/{uid} {
      allow get: if owns(uid) || isStaff();
      allow list: if isStaff();
      allow create, delete: if false;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'name', 'mobile', 'dob', 'preferences',
          'security', 'updatedAt'
        ])
        && validCustomerProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      match /activity/{activityId} {
        allow read: if owns(uid) || isStaff();
        allow write: if false;
      }

      match /coupons/{couponId} {
        allow read: if owns(uid) || isStaff();
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.customerUid == uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if owns(uid)
          && request.resource.data.customerUid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'token', 'platform', 'notificationsEnabled', 'lastSeenAt', 'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(uid);
      }
    }

    // Server-authoritative financial and POS records. Even an admin UI cannot
    // mutate these directly; every mutation must go through audited functions.
    match /loyaltyAccounts/{accountId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    match /loyaltyLedger/{entryId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;

      match /items/{itemId} {
        allow read: if isStaff()
          || (signedIn()
            && get(/databases/$(database)/documents/transactions/$(transactionId)).data.customerUid == request.auth.uid);
        allow write: if false;
      }
    }

    match /redemptions/{redemptionId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    match /customerNotifications/{notificationId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    // Lookup keys are sensitive operational indexes. The mobile app identifies
    // itself by its own auth UID; POS and server code use Admin SDK access.
    match /customerNumbers/{number} { allow read: if isStaff(); allow write: if false; }
    match /membershipCodes/{code} { allow read: if isStaff(); allow write: if false; }
    match /authLinks/{uid} { allow read: if owns(uid) || isStaff(); allow write: if false; }

    // Catalog data contains no secrets. Signed-in members can read it; only an
    // authenticated admin claim can manage it from the admin application.
    match /offers/{id}          { allow read: if signedIn(); allow write: if isAdmin(); }
    match /rewards/{id}         { allow read: if signedIn(); allow write: if isAdmin(); }
    match /fuelPrices/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /menu/{id}            { allow read: if signedIn(); allow write: if isAdmin(); }
    match /categories/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /stations/{id}        { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notifications/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /loyaltyPrograms/{id} { allow read: if signedIn(); allow write: if false; }
    match /campaigns/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }

    // Short-lived end-of-day food specials. A manager can write only their
    // assigned station, and may shorten but never extend a recorded safety cutoff.
    match /nightDeals/{id} {
      allow read: if signedIn();
      allow create: if canManageNightDeals(request.resource.data.stationId)
        && validNightDeal(request.resource.data)
        && request.resource.data.id == id
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageNightDeals(resource.data.stationId)
        && canManageNightDeals(request.resource.data.stationId)
        && request.resource.data.stationId == resource.data.stationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (isAdmin() || request.resource.data.safetyCutoffAt <= resource.data.safetyCutoffAt)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validNightDeal(request.resource.data);
      allow delete: if isAdmin();
    }

    match /campaignProgress/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    match /staff/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow write: if false;
    }

    // Operational collections are intentionally invisible to all client SDKs.
    match /integrationEvents/{id} { allow read, write: if false; }
    match /idempotencyKeys/{id}    { allow read, write: if false; }
    match /outbox/{id}             { allow read, write: if false; }
    match /auditLogs/{id}          { allow read, write: if false; }
    match /schemaMigrations/{id}   { allow read, write: if false; }
    match /system/{id}             { allow read, write: if false; }

    // Default deny protects every collection added in the future until its
    // access model is explicitly reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
